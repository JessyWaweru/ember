# From Supabase → your project → Settings → API Keys (or the "Connect" button at the top)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The *publishable* key (starts with sb_publishable_). Safe to ship in the app: row-level security protects your data.
# Never put the secret key (sb_secret_...) here.
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx
